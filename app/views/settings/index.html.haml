- content_for :title, "Настройки · BrickCRM"
.page-head
  %h1 Настройки
  %span.page-head__hint режимы, доступы и интеграции
.card
  %h2 Способы входа
  %table.table
    %tr
      %td Вход по паролю
      %td
        - if @password_auth
          %span.chip.chip--on включён
        - else
          %span.chip.chip--off выключен (PASSWORD_AUTH=disabled)
    %tr
      %td Вход через SSO
      %td
        - if @sso_enabled
          %span.chip.chip--on= CrmConfig::Sso.provider_name
        - else
          %span.chip.chip--off не сконфигурирован
.card
  %h2 Интеграции
  %table.table
    %tr
      %td Входящие источники событий
      %td
        - if @inbound_sources.any?
          - @inbound_sources.each do |source|
            %code= source
        - else
          %span.chip.chip--off канал закрыт
    %tr
      %td Webhook-эндпоинты
      %td
        - if @webhook_endpoints.any?
          - @webhook_endpoints.each do |endpoint|
            %div
              %code= endpoint.name
              %span.muted= "→ #{endpoint.url}#{" (выключен)" unless endpoint.active}"
        - else
          %span.chip.chip--off не созданы
.card
  %h2 Роли
  - if @roles.any?
    %table.table
      %tr
        %th Ключ
        %th Название
        %th Разделы
      - @roles.each do |role|
        %tr
          %td
            %code= role.key
          %td= role.name
          %td.muted= role.human_sections.join(", ")
  - else
    %p.muted Роли не созданы — выполните bin/rails db:seed
