- content_for :title, "Вход · BrickCRM"
.auth-card
  .auth-card__logo
    .sidebar__logo-mark B
  %h1.auth-card__title Вход в BrickCRM
  - if CrmConfig.password_auth?
    = form_with url: session_path, method: :post, local: true do |f|
      .field
        = f.label :email, "Почта"
        = f.email_field :email, required: true, autofocus: true, autocomplete: "username"
      .field
        = f.label :password, "Пароль"
        = f.password_field :password, required: true, autocomplete: "current-password"
      = f.submit "Войти", class: "btn btn--primary btn--block"
  - if CrmConfig.password_auth? && CrmConfig.sso_enabled?
    .auth-card__divider или
  - if CrmConfig.sso_enabled?
    = link_to "Войти через SSO", sso_start_path, class: "btn btn--block #{CrmConfig.password_auth? ? "btn--secondary" : "btn--primary"}"
  - if !CrmConfig.password_auth? && !CrmConfig.sso_enabled?
    %p.muted Ни один способ входа не сконфигурирован. Проверьте PASSWORD_AUTH и SSO_* в окружении.
